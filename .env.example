
# Aplikasi
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
REQUEST_TIMEOUT_MS=15000
REQUEST_MAX_BODY_BYTES=262144
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
LOG_RETENTION_DAYS=90

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=argus
DB_USER=postgres
DB_PASSWORD=12345678
DB_POOL_SIZE=10
DB_SSL=false
MIGRATIONS_RUN=false
MIGRATIONS_PATH=./migrations

# Storage foto
STORAGE_DRIVER=filesystem
STORAGE_DIR=./var/photos
# Harus mengarah ke alamat backend yang bisa dibuka browser (dipakai URL foto).
PUBLIC_API_URL=http://localhost:3001/api/v1
PHOTO_URL_SECRET=f24e82e57c7db31a906cae1c6113c312f02c4f2b9ab03a0420f20a05aa80a811
PHOTO_SIGNED_URL_TTL_SECONDS=900
PHOTO_MAX_BYTES=2097152

# S3/MinIO (dipakai bila STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=argus-photos
S3_ACCESS_KEY=argus-minio-access
S3_SECRET_KEY=argus-minio-secret
S3_REGION=us-east-1

# Cloudinary (dipakai bila STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=argus/photos

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
IP_HASH_SALT=

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=argus-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_SESSION_EXPIRY_SECONDS=604800
# MQTT_CA_PATH=/etc/argus/ca.crt
SCALE_TIME_SKEW_SECONDS=120

# Layanan eksternal
MAPBOX_TOKEN=
MAPBOX_TIMEOUT_MS=8000
OPTIMIZER_URL=http://localhost:8100
OPTIMIZER_TIMEOUT_MS=12000
SWARM_RECOVERY_OPT_TIMEOUT_MS=15000
SWARM_RECOVERY_TARGET_MS=60000
ANALYTICS_URL=http://localhost:8200
ANALYTICS_TIMEOUT_MS=10000
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_OUTPUT_TOKENS=320
LLM_TIMEOUT_MS=15000

# Narasi dashboard (fitur mati bila LLM_API_KEY kosong)
NARRATIVE_TTL_MINUTES=360
NARRATIVE_DAILY_LIMIT=40
NARRATIVE_MAX_CHARS=700
NARRATIVE_RETRY_AFTER_SECONDS=3

# Liveness armada
STALE_THRESHOLD_SECONDS=180
OFFLINE_THRESHOLD_SECONDS=600
WATCHDOG_INTERVAL_SECONDS=60

# Telemetri masuk
TELEMETRY_MAX_AGE_SECONDS=604800
TELEMETRY_FUTURE_SKEW_SECONDS=300
TELEMETRY_BURST_LIMIT=600
TELEMETRY_REFILL_PER_SECOND=2

# Perangkat & timbangan
DEVICE_SECRET_ENC_KEY=
SCALE_AUTO_LINK_WINDOW_SECONDS=120
SCALE_PENDING_MAX_AGE_HOURS=24
SCALE_SWEEP_INTERVAL_SECONDS=300

# Rute
ROUTE_WINDOW_START=09:00
ROUTE_WINDOW_END=15:00
ROUTE_TIME_LIMIT_SECONDS=10
ROUTE_FALLBACK_SPEED_KMH=25
ROUTE_RECOVERY_INTERVAL_SECONDS=30

# Disposisi
CANDIDATE_RADIUS_KM=25

# Verifikasi rantai
CHAIN_VERIFY_DAILY_BATCHES=100
CHAIN_VERIFY_SAMPLE_PERCENT=5

# Retensi data
TELEMETRY_COMPRESS_AFTER_DAYS=7
TELEMETRY_DROP_AFTER_DAYS=90
PHOTO_TICKET_RETENTION_DAYS=366
PHOTO_BATCH_RETENTION_DAYS=731
PHOTO_PURGE_MAX_PER_RUN=200
RETENTION_PURGE_ENABLED=false

# Rate limit
THROTTLE_GLOBAL_PER_MIN=100
TICKET_RATE_PER_HOUR=3
TICKET_RATE_PER_DAY_PER_SPPG=20
EXPORT_RATE_PER_DAY=10
EXPORT_PDF_MAX_ROWS=2000

# Notifikasi operasional 
OPS_WEBHOOK_URL=
OPS_WEBHOOK_TIMEOUT_MS=5000

# Demo
DEMO_MODE=false

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=password123
SEED_DEMO=false
# Token internal optimizer (samakan dengan INTERNAL_SERVICE_TOKEN di python/.env)
OPTIMIZER_TOKEN=


# Peta & rute bersadarkan lalu lintas
# Prioritas penyedia: Google Routes (GOOGLE_MAPS_API_KEY) -> Mapbox driving-traffic (MAPBOX_TOKEN)
# -> OSRM (jalan sungguhan tanpa data macet) -> garis lurus (cadangan jujur).
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TRAFFIC=true
ROUTING_ALTERNATIVES=3
ROUTING_TIMEOUT_MS=8000

# Penugasan otomatis: batch baru langsung dihitung prioritasnya dan masuk rute
# bila ada armada berkapasitas. Admin tetap bisa mengoreksi di /dispatch.
DISPATCH_AUTO_ON_CREATE=true
DISPATCH_MAX_PER_RUN=8